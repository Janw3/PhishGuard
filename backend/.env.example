# Backend configuration. Copy to backend/.env and adjust; .env is never committed.
# All values are optional; the defaults are shown. Environment variables override this file.
# Restart the backend after changing it.

# ---- Model selection --------------------------------------------------------
# The model used when a request does not name one. Any name from GET /models:
#   logistic_regression, random_forest           (trained here, artifacts/*.pkl)
#   cybersectony_distilbert, dima806_distilbert  (pretrained, downloaded on first use)
DEFAULT_MODEL=cybersectony_distilbert

# Load the default model in the background at startup, so the first analysis is fast.
PRELOAD_DEFAULT_MODEL=true

# Pretrained Hugging Face models to offer (comma-separated). Leave empty for none.
PRETRAINED_MODELS=cybersectony_distilbert,dima806_distilbert

# ---- Optional LLM-written explanations ------------------------------------------
# Off by default (templates only). The LLM only rewrites the generic text of model
# highlights; on any problem the template is used. Only the highlighted phrase and one
# sentence of context are sent, never the whole email. Swap models freely.
#
# Local with Ollama (install from ollama.com, then: ollama pull llama3.2:3b):
#   LLM_PROVIDER=openai
#   LLM_MODEL=llama3.2:3b
#   LLM_BASE_URL=http://localhost:11434/v1         # in Docker: http://host.docker.internal:11434/v1
#
# Any OpenAI-compatible cloud API (EXTERNAL: excerpts leave your machine):
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#
# Claude (EXTERNAL) via the official SDK:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-opus-5-5
#   LLM_API_KEY=sk-ant-...                         # or set ANTHROPIC_API_KEY
LLM_PROVIDER=none
# LLM_TIMEOUT=15

# ---- Paths (absolute, or relative to the directory you start the backend from)
# DATA_DIR=data
# PREPARED_DATA_PATH=data/prepared.csv
# ARTIFACTS_DIR=artifacts
# REPORTS_DIR=../reports

# ---- API ----------------------------------------------------------------------
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# P(phishing) inside [UNCERTAIN_LOW, UNCERTAIN_HIGH] is flagged as uncertain
UNCERTAIN_LOW=0.4
UNCERTAIN_HIGH=0.6
